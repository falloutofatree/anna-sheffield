                "slide_1_enabled": true,
                "slide_1_image": "shopify://shop_images/AS_About_Educational_2000x_13a3cabc-4a3a-43ad-b9fc-ebb6665485f3.webp",
                "slide_1_aspect_ratio": "3/2",
                "slide_1_fit": "contain",
                "slide_1_content": "<h6>EDUCATIONAL<br/><br/>The Flowering Tree Permaculture, in Santa Clara Pueblo, is working to build a sustainable future through community gardening, seed saving, weaving and other practices rooted in “indigenous ways of knowing.”  </h6><h6>Keres Learning Center teaches the indigenous language to children in several Pueblo communities, highlighting the importance of  “passing on history, values, beliefs, and a worldview.”</h6>",
                "slide_2_enabled": true,
                "slide_2_image": "shopify://shop_images/AS_About_Environmental_2000x_895a07af-dfe0-4f93-b3d7-91c412617592.webp",
                "slide_2_aspect_ratio": "3/2",
                "slide_2_fit": "contain",
                "slide_2_content": "<h6>ENVIRONMENTAL</h6><h6>Amigos Bravos and Wild Earth Guardians work to protect the precious land, rivers and watershed of the high desert, as well as leading the charge in environmental conservation and preservation of the diverse wildlife found throughout New Mexico.</h6>",
                "slide_3_enabled": false,
                "slide_3_image": "shopify://shop_images/AS_About_Cultural_2000x_099f306d-a6fe-4a88-8734-d42c85da8ab0.webp",
                "slide_3_aspect_ratio": "16/9",
                "slide_3_fit": "cover",
                "slide_3_content": "<h6>Cultural</h6><h6>The Flowering Tree Permaculture, in Santa Clara Pueblo, is working to build a sustainable future through community gardening, seed saving, weaving and other practices rooted in “indigenous ways of knowing.”  </h6><h6>Keres Learning Center teaches the indigenous language to children in several Pueblo communities, highlighting the importance of  “passing on history, values, beliefs, and a worldview.”</h6>",
