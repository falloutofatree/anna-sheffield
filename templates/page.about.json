                  "blocks": {}
                },
                "text_VBAcpR": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Disturbance of precious earth, water and soil contamination, and decreased biodiversity are just some of the effects of mining, so we consider our reclaimed and recycled material initiatives an important—and imperative—choice for our jewelry.</p>",
                    "width": "fit-content",
                    "max_width": "normal",
                    "alignment": "left",
