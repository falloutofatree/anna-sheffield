            "ai_gen_block_fae9c10_gVmctE": {
              "type": "ai_gen_block_fae9c10",
              "settings": {
                "desktop_width_percent": 100,
                "border_radius": 0,
                "content_padding": 20,
                "content_text_color": "#ffffff",
                "dot_size": 10,
