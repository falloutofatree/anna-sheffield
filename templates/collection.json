    "custom_liquid_aCgT9x": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<div id=\"custom-teleport-newsletter\" style=\"display: none;\">\n  <div class=\"inline-newsletter-wrapper\">\n    <h3 class=\"newsletter-title\">Join The List</h3>\n    <p>Sign up to get the latest on new releases and exclusive collections.</p>\n    \n    {% form 'customer', class: 'inline-newsletter-form' %}\n      <input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter\">\n      <div class=\"newsletter-input-group\">\n        <input type=\"email\" name=\"contact[email]\" placeholder=\"Email Address\" required>\n        <button type=\"submit\" class=\"button\">Subscribe</button>\n      </div>\n      {%- if form.posted_successfully? -%}\n        <p class=\"success-message\" style=\"margin-top: 10px; color: green;\">Thanks for subscribing!</p>\n      {%- endif -%}\n    {% endform %}\n  </div>\n</div>\n\n<style>\n  .inline-newsletter-wrapper {\n    grid-column: 1 / -1 !important; \n    width: 100%;\n    background-color: #f4f4f4; \n    padding: 40px 20px;\n    margin: 20px 0;\n    text-align: center;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n  }\n  .newsletter-title {\n    font-family: 'Styrene A', sans-serif;\n    text-transform: uppercase;\n    margin-bottom: 10px;\n    letter-spacing: 1px;\n  }\n  .inline-newsletter-form {\n    max-width: 400px;\n    width: 100%;\n    margin-top: 15px;\n  }\n  .newsletter-input-group {\n    display: flex;\n    gap: 10px;\n  }\n  .newsletter-input-group input {\n    flex: 1;\n    padding: 12px;\n    border: 1px solid #ccc;\n    min-width: 0;\n  }\n  .newsletter-input-group button {\n    padding: 12px 24px;\n    cursor: pointer;\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    let attempts = 0;\n    \n    // Set a timer to check the page every 500 milliseconds\n    const teleportInterval = setInterval(function() {\n      const newsletterBox = document.getElementById('custom-teleport-newsletter');\n      \n      // 👇👇👇 CHANGE THIS LINE 👇👇👇\n      // Replace '.product-card' with the exact class name you found in Step 1!\n      // Make sure to keep the period (.) in front of the name.\n      const productCards = document.querySelectorAll('.product-card'); \n      \n      if (productCards.length >= 4 && newsletterBox) {\n        // Grab the container that holds all the cards\n        const gridContainer = productCards[0].parentNode;\n        \n        // Insert the newsletter right before the 5th card (index 4)\n        gridContainer.insertBefore(newsletterBox, productCards[4]);\n        \n        // Un-hide the newsletter\n        newsletterBox.style.display = 'block';\n        \n        // Success! Stop checking.\n        clearInterval(teleportInterval); \n      }\n      \n      attempts++;\n      // Give up after 10 attempts (5 seconds) so we don't slow down the browser\n      if (attempts > 10) clearInterval(teleportInterval); \n      \n    }, 500); \n  });\n</script>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
