                    "custom_liquid": "<div id=\"tag-marker-{{ block.id }}\" style=\"display:none;\"></div>\n\n<script>\n  // Because tags apply to the whole product, we only need to check it once when the page loads\n  setTimeout(function() {\n    \n    // 1. Find the block on the page\n    const marker = document.getElementById(\"tag-marker-{{ block.id }}\");\n    if (!marker) return;\n    \n    const parentBox = marker.closest(\".group-block\");\n    if (!parentBox) return;\n\n    // 2. Check if the Shopify product contains the exact tag\n    const hasTag = {% if product.tags contains 'AS STACKING GUIDE' %}true{% else %}false{% endif %};\n\n    // 3. The Logic: SHOW the block if true, otherwise HIDE\n    if (hasTag === true) {\n      parentBox.style.display = \"\";\n    } else {\n      parentBox.style.display = \"none\";\n    }\n    \n  }, 100); \n</script>"
