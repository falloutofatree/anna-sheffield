              },
              "blocks": {
                "custom_liquid_X8c38D": {
                  "type": "custom-liquid",
                  "name": "t:names.custom_liquid",
                  "settings": {
                    "custom_liquid": "<div id=\"pairs-visibility-{{ block.id }}\" style=\"display:none;\"></div>\n\n<script>\n  // Because this is a Product metafield, we only check it once when the page loads\n  setTimeout(function() {\n    \n    // 1. Find the block on the page\n    const marker = document.getElementById(\"pairs-visibility-{{ block.id }}\");\n    if (!marker) return;\n    \n    const parentBox = marker.closest(\".group-block\");\n    if (!parentBox) return;\n\n    // 2. Check if the metafield is blank using Shopify Liquid\n    const isEmpty = {% if product.metafields.nyla.pairs_well_with.value == blank %}true{% else %}false{% endif %};\n\n    // 3. The Logic: HIDE the block if empty, otherwise SHOW it\n    if (isEmpty === true) {\n      parentBox.style.display = \"none\";\n    } else {\n      parentBox.style.display = \"\";\n    }\n    \n  }, 100); \n</script>"
                  },
                  "blocks": {}
                },
                "text_kDzpw7": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<h6><strong>PAIRS WELL WITH:</strong></h6>",
                    "width": "fit-content",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "color": "var(--color-foreground)",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                },
                "custom_liquid_yNxhnE": {
                  "type": "custom-liquid",
                  "name": "Collection slider",
                  "settings": {
                    "custom_liquid": "{%- assign paired_data = product.metafields.nyla.pairs_well_with.value -%}\n{%- assign paired_products = paired_data.products | default: paired_data -%}\n\n{%- if paired_products != blank -%}\n  <div class=\"pairs-slider-wrapper-{{ block.id }}\" style=\"width: 100%; max-width: 100%; min-width: 0; overflow: hidden;\">\n    \n    <div class=\"pairs-slider-track\" id=\"slider-{{ block.id }}\" style=\"display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none; gap: 10px; padding-bottom: 5px;\">\n      \n      {%- for item in paired_products limit: 8 -%}\n        <a href=\"{{ item.url }}\" class=\"pairs-slide\" style=\"flex: 0 0 63%; max-width: 63%; scroll-snap-align: start; background-color: #ffffff; text-decoration: none; display: block; aspect-ratio: 1 / 1;\">\n          <img src=\"{{ item.featured_image | image_url: width: 600, height: 600 }}\" alt=\"{{ item.title | escape }}\" loading=\"lazy\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;\">\n        </a>\n      {%- endfor -%}\n      \n    </div>\n\n    <div class=\"pairs-slider-dots\" id=\"dots-{{ block.id }}\" style=\"display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-top: 15px;\">\n      {%- for item in paired_products limit: 8 -%}\n        <span class=\"pairs-dot\" data-index=\"{{ forloop.index0 }}\" style=\"width: 6px; height: 6px; flex-shrink: 0; border-radius: 50%; background-color: {% if forloop.first %}#000000{% else %}#dfdfdf{% endif %}; cursor: pointer; transition: background-color 0.2s ease;\"></span>\n      {%- endfor -%}\n    </div>\n  </div>\n\n  <style>\n    /* Hide the scrollbar for webkit browsers (Chrome/Safari/iOS) */\n    #slider-{{ block.id }}::-webkit-scrollbar { \n      display: none; \n    }\n  </style>\n\n  <script>\n    document.addEventListener(\"DOMContentLoaded\", function() {\n      const track = document.getElementById(\"slider-{{ block.id }}\");\n      const dots = document.querySelectorAll(\"#dots-{{ block.id }} .pairs-dot\");\n\n      if (!track || dots.length === 0) return;\n\n      // Update the active black dot when swiping\n      track.addEventListener(\"scroll\", function() {\n        let slideWidth = track.querySelector(\".pairs-slide\").offsetWidth;\n        // 10 is the pixel gap between images\n        let activeIndex = Math.round(track.scrollLeft / (slideWidth + 10)); \n\n        dots.forEach((dot, index) => {\n          if (index === activeIndex) {\n            dot.style.backgroundColor = \"#000000\";\n          } else {\n            dot.style.backgroundColor = \"#dfdfdf\";\n          }\n        });\n      });\n\n      // Allow clicking the dots to slide to that specific image\n      dots.forEach((dot, index) => {\n        dot.addEventListener(\"click\", () => {\n          let slideWidth = track.querySelector(\".pairs-slide\").offsetWidth;\n          track.scrollTo({ left: index * (slideWidth + 10), behavior: \"smooth\" });\n        });\n      });\n    });\n  </script>\n{%- endif -%}"
                  },
                  "blocks": {}
                }
              },
