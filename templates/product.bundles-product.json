                    "custom_liquid_UCU4BJ": {
                      "type": "custom-liquid",
                      "name": "Contact modal",
                      "settings": {
                        "custom_liquid": "<div id=\"email-modal-overlay\" class=\"custom-modal-overlay\">\n  <div class=\"custom-modal-box\">\n    \n    <button class=\"custom-modal-close\" aria-label=\"Close modal\">&times;</button>\n    \n    <div class=\"custom-modal-layout\">\n      \n      <div class=\"custom-form-col\">\n        <h2 class=\"custom-modal-title\">Contact Us</h2>\n        \n        {% form 'contact', id: 'EmailUsContactForm' %}\n          {% if form.posted_successfully? %}\n            <p class=\"custom-success-msg\">Thanks for reaching out! We will get back to you shortly.</p>\n          {% endif %}\n\n          {{ form.errors | default_errors }}\n\n          <div class=\"custom-input-group\">\n            <select id=\"ModalSubject\" name=\"contact[Subject]\" class=\"custom-modal-input\" required>\n              <option value=\"\" disabled selected>Select a Subject*</option>\n              <option value=\"Custom\">CUSTOM</option>\n              <option value=\"Besting & Staking Bands\">BESTING & STAKING BANDS</option>\n              <option value=\"Order Status\">ORDER STATUS</option>\n              <option value=\"Financing\">FINANCING</option>\n              <option value=\"Pop Ups\">POP UPS...</option>\n              <option value=\"Other\">OTHER</option>\n            </select>\n          </div>\n\n          <div class=\"custom-input-group\">\n            <input type=\"text\" id=\"ModalName\" name=\"contact[name]\" placeholder=\"Name*\" required class=\"custom-modal-input\">\n          </div>\n          \n          <div class=\"custom-input-group\">\n            <input type=\"email\" id=\"ModalEmail\" name=\"contact[email]\" placeholder=\"Email*\" required class=\"custom-modal-input\">\n          </div>\n\n          <div class=\"custom-input-group\">\n            <input type=\"tel\" id=\"ModalPhone\" name=\"contact[phone]\" placeholder=\"Phone (Optional)\" class=\"custom-modal-input\">\n          </div>\n          \n          <div class=\"custom-input-group\">\n            <textarea id=\"ModalMessage\" name=\"contact[body]\" rows=\"4\" placeholder=\"Leave us a message*\" required class=\"custom-modal-input\"></textarea>\n          </div>\n          \n          <button type=\"submit\" class=\"custom-modal-submit\">SUBMIT</button>\n        {% endform %}\n      </div>\n\n      <div class=\"custom-image-col\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0039/8002/files/AS4-18-1829986_2x_1500x_1500x_23110a17-04b2-46a2-9815-719b91d677bf.webp?v=1770821389\" alt=\"Contact Us\" class=\"custom-modal-image\">\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<style>\n  /* Dark Overlay */\n  .custom-modal-overlay {\n    position: fixed;\n    top: 0; left: 0; width: 100%; height: 100%;\n    background: rgba(0, 0, 0, 0.6);\n    z-index: 999999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 0.3s ease;\n  }\n\n  /* Medium Modal Box */\n  .custom-modal-box {\n    background: #fff;\n    width: 90%;\n    max-width: 800px; /* Medium width */\n    max-height: 90vh;\n    position: relative;\n    box-shadow: 0 10px 40px rgba(0,0,0,0.2);\n    transform: translateY(20px);\n    transition: transform 0.3s ease;\n    overflow: hidden;\n  }\n\n  /* 2-Column Flex Layout */\n  .custom-modal-layout {\n    display: flex;\n    flex-direction: row;\n    width: 100%;\n    height: 100%;\n  }\n\n  /* Left Column: Form Settings */\n  .custom-form-col {\n    flex: 1;\n    padding: 40px;\n    overflow-y: auto;\n  }\n  \n  .custom-modal-title {\n    font-family: 'Styrene A', sans-serif;\n    margin-top: 0;\n    margin-bottom: 20px;\n    font-size: 20px;\n    letter-spacing: 0.5px;\n  }\n\n  .custom-success-msg {\n    color: #2e7d32;\n    font-size: 14px;\n    margin-bottom: 15px;\n  }\n\n  /* Right Column: Image Settings */\n  .custom-image-col {\n    flex: 1;\n    background: #f4f4f4;\n    display: flex;\n  }\n  \n  .custom-modal-image {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  /* The 'X' Close Button */\n  .custom-modal-close {\n    position: absolute;\n    top: 15px; right: 15px;\n    background: none; border: none;\n    font-size: 28px;\n    cursor: pointer;\n    color: #000;\n    z-index: 10;\n    line-height: 1;\n  }\n  \n  /* Give the X a white background drop-shadow so it's visible over dark images */\n  .custom-image-col + .custom-modal-close,\n  .custom-modal-close {\n    text-shadow: 0 0 10px rgba(255,255,255,0.8); \n  }\n\n  /* Input Fields */\n  .custom-input-group { margin-bottom: 15px; }\n  .custom-modal-input {\n    width: 100%;\n    padding: 12px;\n    border: 1px solid #ddd;\n    font-family: sans-serif;\n    font-size: 13px;\n    box-sizing: border-box;\n    background-color: #fff;\n    color: #000;\n  }\n  .custom-modal-input:focus { outline: none; border-color: #000; }\n  \n  select.custom-modal-input {\n    cursor: pointer;\n    appearance: none;\n    background-image: url(\"data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e\");\n    background-repeat: no-repeat;\n    background-position: right 1rem center;\n    background-size: 1em;\n  }\n\n  /* Submit Button */\n  .custom-modal-submit {\n    width: 100%; background: #000; color: #fff;\n    padding: 14px; border: none; cursor: pointer;\n    font-family: 'Styrene A', sans-serif; font-size: 12px;\n    letter-spacing: 1px; margin-top: 10px; transition: background 0.2s ease;\n  }\n  .custom-modal-submit:hover { background: #333; }\n\n  /* Activation Classes */\n  .custom-modal-overlay.is-open {\n    opacity: 1;\n    pointer-events: auto;\n  }\n  .custom-modal-overlay.is-open .custom-modal-box {\n    transform: translateY(0);\n  }\n\n  /* MOBILE RESPONSIVENESS */\n  @media screen and (max-width: 768px) {\n    .custom-modal-layout {\n      flex-direction: column-reverse; /* Form on top, Image on bottom for better UX */\n    }\n    .custom-image-col {\n      height: 200px;\n      flex: none;\n    }\n    .custom-form-col {\n      padding: 30px 20px;\n    }\n    .custom-modal-close {\n      color: #000; /* Ensure visibility on mobile */\n      text-shadow: none;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    const triggerLinks = document.querySelectorAll('a[href=\"#email-us\"]');\n    const overlay = document.getElementById(\"email-modal-overlay\");\n    const closeBtn = document.querySelector(\".custom-modal-close\");\n\n    if (overlay) {\n      // 1. Open Modal\n      triggerLinks.forEach(function(link) {\n        link.addEventListener(\"click\", function(e) {\n          e.preventDefault(); \n          overlay.classList.add(\"is-open\");\n        });\n      });\n\n      // 2. Close Modal via 'X'\n      if (closeBtn) {\n        closeBtn.addEventListener(\"click\", function() {\n          overlay.classList.remove(\"is-open\");\n        });\n      }\n\n      // 3. Close Modal by clicking outside\n      overlay.addEventListener(\"click\", function(e) {\n        if (e.target === overlay) {\n          overlay.classList.remove(\"is-open\");\n        }\n      });\n      \n      // 4. Close Modal with 'Escape' key\n      document.addEventListener(\"keydown\", function(e) {\n        if (e.key === \"Escape\" && overlay.classList.contains(\"is-open\")) {\n          overlay.classList.remove(\"is-open\");\n        }\n      });\n    }\n  });\n</script>"
                      },
                      "blocks": {}
                    },
                    "custom_liquid_8Ckwfm": {
                      "type": "custom-liquid",
                      "name": "Gorgias modal",
                      "settings": {
                        "custom_liquid": "<script>\n  document.addEventListener('click', function(event) {\n    // 1. Check if the clicked item is our specific chat link\n    const chatLink = event.target.closest('a[href=\"#gorgias-chat\"]');\n    \n    if (chatLink) {\n      event.preventDefault(); // 2. Stops the screen from jumping\n      \n      // 3. Command Gorgias to open the chatbox\n      if (typeof GorgiasChat !== 'undefined') {\n        GorgiasChat.open();\n      }\n    }\n  });\n</script>"
                      },
                      "blocks": {}
                    }
