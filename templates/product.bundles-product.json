              },
              "blocks": {
                "custom_liquid_Cjdk8g": {
                  "type": "custom-liquid",
                  "name": "t:names.custom_liquid",
                  "settings": {
                    "custom_liquid": "<div id=\"visibility-marker-{{ block.id }}\" style=\"display:none;\"></div>\n\n<script>\n  // 1. Create a simple list of your product's variant prices.\n  // We divide the Shopify price by 100 so a $550 item reads as 550 (not 55000 cents).\n  const variantPrices = {\n    {% for variant in product.variants %}\n      \"{{ variant.id }}\": {{ variant.price | divided_by: 100.0 }},\n    {% endfor %}\n  };\n\n  // 2. This is the main function that checks the math\n  function checkVisibility() {\n    \n    // Find the marker we created above, and find the parent group block it lives inside\n    const marker = document.getElementById(\"visibility-marker-{{ block.id }}\");\n    if (!marker) return; \n    \n    const parentBlock = marker.closest(\".group-block\");\n    if (!parentBlock) return;\n\n    // Find the quantity the customer currently has selected on the screen\n    const quantityBox = document.querySelector('input[name=\"quantity\"]');\n    const productQuantity = quantityBox ? parseInt(quantityBox.value) : 1;\n\n    // Find which variant (like Sterling Silver vs Gold) is currently selected\n    const urlParams = new URLSearchParams(window.location.search);\n    const currentVariantId = urlParams.get(\"variant\") || \"{{ product.selected_or_first_available_variant.id }}\";\n    \n    // Get the price for that specific variant\n    const productVariantPrice = variantPrices[currentVariantId];\n\n    // ==========================================\n    // THE EQUATION\n    // Multiply the variant price by the quantity\n    // ==========================================\n    const totalValue = productVariantPrice * productQuantity;\n\n    // ==========================================\n    // THE LOGIC\n    // If the total is less than 1500, SHOW the block. \n    // If it is 1500 or higher, HIDE the block.\n    // ==========================================\n    if (totalValue < 1500) {\n      parentBlock.style.display = \"\";      // This SHOWS the block\n    } else {\n      parentBlock.style.display = \"none\";  // This HIDES the block\n    }\n  }\n\n  // 3. Run the math immediately when the page first loads\n  setTimeout(checkVisibility, 100);\n\n  // 4. Run the math again anytime the user clicks a swatch or changes the quantity\n  document.addEventListener(\"click\", function() {\n    setTimeout(checkVisibility, 150);\n  });\n  \n  document.addEventListener(\"change\", function() {\n    setTimeout(checkVisibility, 150);\n  });\n</script>"
                  },
