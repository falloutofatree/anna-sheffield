                    "custom_liquid": "<div id=\"price-qty-target-{{ block.id }}\" style=\"display:none;\"></div>\n\n<script>\n  (function() {\n    // 1. We create a mini-database of all your variant prices using Liquid\n    var variantPrices = {\n      {% for variant in product.variants %}\n        \"{{ variant.id }}\": {{ variant.price }},\n      {% endfor %}\n    };\n    \n    // The threshold is $1500.00 (written in cents as 150000)\n    var thresholdCents = 150000;\n\n    function evaluateVisibility() {\n      var marker = document.getElementById('price-qty-target-{{ block.id }}');\n      if (!marker) return;\n      \n      var directParent = marker.closest('.group-block');\n      if (!directParent) return;\n\n      // 2. Find the current quantity in the user's input box (defaults to 1 if not found)\n      var qtyInput = document.querySelector('input[name=\"quantity\"]');\n      var currentQty = qtyInput ? parseInt(qtyInput.value) || 1 : 1;\n\n      // 3. Find the currently selected variant ID (Shopify themes usually put this in the URL)\n      var urlParams = new URLSearchParams(window.location.search);\n      var currentVariantId = urlParams.get('variant') || \"{{ product.selected_or_first_available_variant.id }}\";\n\n      // 4. Do the math: Price x Quantity\n      var currentPriceCents = variantPrices[currentVariantId] || {{ product.selected_or_first_available_variant.price }};\n      var totalValueCents = currentPriceCents * currentQty;\n\n      // 5. The Logic: Hide if $1500 or more, show if less than $1500\n      if (totalValueCents >= thresholdCents) {\n        directParent.style.display = 'none';\n      } else {\n        directParent.style.display = ''; // This un-hides it!\n      }\n    }\n\n    // Run the math immediately when the page loads\n    setTimeout(evaluateVisibility, 50);\n\n    // Listen continuously for any changes to the quantity box or variant selectors\n    document.addEventListener('change', function(event) {\n      // If the user clicks a new variant or changes the quantity, recalculate instantly\n      setTimeout(evaluateVisibility, 50); \n    });\n  })();\n</script>"
                  },
