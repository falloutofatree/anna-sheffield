          "blocks": {
            "custom_liquid_7AUhLb": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<div id=\"carousel-pagination-{{ block.id }}\" class=\"custom-bullet-pagination\"></div>\n\n<style>\n  .custom-bullet-pagination {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 24px; /* Space between bullets */\n    padding: 24px 0;\n    width: 100%;\n    z-index: 10;\n    background: transparent;\n  }\n\n  .custom-bullet-pagination .bullet-dot {\n    width: 8px; /* 8px size */\n    height: 8px; /* 8px size */\n    border-radius: 50%;\n    background-color: #bdbdc1; /* Default color */\n    cursor: pointer;\n    transition: background-color 0.3s ease, transform 0.2s ease;\n    padding: 0;\n    border: none;\n    outline: none;\n    appearance: none;\n    display: block;\n  }\n\n  .custom-bullet-pagination .bullet-dot.active {\n    background-color: #000000; /* Active color black */\n    transform: scale(1.1);\n  }\n\n  /* Prevent layout shift before JS moves it */\n  .custom-bullet-pagination:not(.initialized) {\n    display: none;\n  }\n</style>\n\n<script>\n  (function() {\n    const initPagination = () => {\n      const container = document.getElementById('carousel-pagination-{{ block.id }}');\n      if (!container) return;\n\n      const section = container.closest('.shopify-section');\n      if (!section) return;\n\n      // Force the pagination to the bottom of the section structure\n      // regardless of where the block was added in the editor.\n      section.appendChild(container);\n      container.classList.add('initialized');\n\n      // Identify the scrollable track\n      const track = section.querySelector('slideshow-slides') || \n                    section.querySelector('.marquee-track') || \n                    section.querySelector('.slider-track') ||\n                    section.querySelector('.slider');\n      \n      if (!track) return;\n\n      // Get individual slides\n      const slides = Array.from(track.children).filter(el => {\n        const style = window.getComputedStyle(el);\n        return style.display !== 'none' && style.visibility !== 'hidden';\n      });\n\n      // Hide if 1 or 0 slides\n      if (slides.length <= 1) {\n        container.style.display = 'none';\n        return;\n      }\n\n      container.innerHTML = '';\n      const bullets = [];\n\n      slides.forEach((slide, index) => {\n        const dot = document.createElement('button');\n        dot.classList.add('bullet-dot');\n        dot.setAttribute('aria-label', `Go to slide ${index + 1}`);\n        dot.setAttribute('type', 'button');\n        if (index === 0) dot.classList.add('active');\n\n        dot.addEventListener('click', (e) => {\n          e.preventDefault();\n          const scrollPos = slide.offsetLeft - track.offsetLeft;\n          track.scrollTo({ left: scrollPos, behavior: 'smooth' });\n        });\n\n        container.appendChild(dot);\n        bullets.push(dot);\n      });\n\n      // Update active state on scroll\n      const updateActive = () => {\n        const slideWidth = slides[0].offsetWidth;\n        const activeIndex = Math.round(track.scrollLeft / slideWidth);\n\n        bullets.forEach((dot, idx) => {\n          dot.classList.toggle('active', idx === activeIndex);\n        });\n      };\n\n      track.addEventListener('scroll', updateActive, { passive: true });\n      \n      // Handle window resize to keep logic accurate\n      window.addEventListener('resize', updateActive, { passive: true });\n    };\n\n    // Run on load\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initPagination);\n    } else {\n      initPagination();\n    }\n\n    // Support for Shopify Theme Editor updates\n    document.addEventListener('shopify:section:load', (e) => {\n      if (e.target.contains(document.getElementById('carousel-pagination-{{ block.id }}'))) {\n        initPagination();\n      }\n    });\n  })();\n</script>"
              },
              "blocks": {}
            },
            "custom_liquid_3xEiEt": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<div id=\"pagination-anchor-{{ block.id }}\"></div>\n\n<style>\n  /* This will be attached to the top-level section, safe from overflow clipping */\n  .custom-pill-pagination {\n    display: inline-flex;\n    gap: 8px; /* Space between the dots */\n    padding: 8px 16px;\n    background-color: #ffffff;\n    border: 1px solid #e5e5e5; /* Light grey border */\n    border-radius: 50px; /* Pill shape */\n    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);\n    \n    /* Absolute positioning to float over the slider */\n    position: absolute;\n    bottom: 25px; /* Distance from the bottom. Increase if it overlaps text! */\n    left: 50%;\n    transform: translateX(-50%);\n    z-index: 99; /* Forces it to the very front */\n  }\n\n  /* The 4x4 rounded dots */\n  .custom-pill-pagination .custom-dot {\n    width: 4px;\n    height: 4px;\n    border-radius: 2px;\n    background-color: #cccccc; /* Default grey */\n    cursor: pointer;\n    transition: background-color 0.3s ease, transform 0.2s ease;\n  }\n\n  /* The active state */\n  .custom-pill-pagination .custom-dot.active {\n    background-color: #000000; /* Active black */\n    transform: scale(1.2); /* Tiny pop effect */\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    // 1. Find our anchor inside the slide\n    const anchor = document.getElementById('pagination-anchor-{{ block.id }}');\n    if (!anchor) return;\n\n    // 2. Climb up to find the main Shopify section wrapping this entire slider\n    const section = anchor.closest('.shopify-section');\n    if (!section) return;\n\n    // 3. Find the scrollable track and count the slides\n    // (Looks for the most common Shopify/Horizon slider class names)\n    const track = section.querySelector('.slider, ul.grid, .slider-track, slider-component ul'); \n    if (!track) return;\n    \n    // Grab all actual slides (ignoring any random hidden divs)\n    const slides = Array.from(track.children).filter(el => el.tagName === 'LI' || el.tagName === 'DIV');\n    if (slides.length <= 1) return;\n\n    // 4. Find a \"safe\" container to attach the dots so they don't get clipped\n    const safeContainer = section.querySelector('slider-component') || section.firstElementChild;\n    safeContainer.style.position = 'relative'; // Ensures absolute positioning works\n\n    // 5. Build the pill container from scratch\n    const pill = document.createElement('div');\n    pill.className = 'custom-pill-pagination';\n\n    // 6. Generate the exact number of dots needed\n    slides.forEach((slide, index) => {\n      const dot = document.createElement('div');\n      dot.className = 'custom-dot';\n      if (index === 0) dot.classList.add('active');\n\n      // Click Event: Scroll the track to this exact slide\n      dot.addEventListener('click', () => {\n        const scrollPos = slide.offsetLeft - track.offsetLeft;\n        track.scrollTo({ left: scrollPos, behavior: 'smooth' });\n      });\n\n      pill.appendChild(dot);\n    });\n\n    // 7. Attach the finished dots to the safe container\n    safeContainer.appendChild(pill);\n\n    // 8. Update which dot is black when the user naturally swipes\n    track.addEventListener('scroll', () => {\n      // Calculate which slide is closest to the left edge\n      let currentIndex = Math.round(track.scrollLeft / slides[0].offsetWidth);\n      \n      // Failsafe to prevent errors at the very ends of the scroll\n      if (currentIndex < 0) currentIndex = 0;\n      if (currentIndex >= slides.length) currentIndex = slides.length - 1;\n\n      // Swap the active class\n      const allDots = pill.querySelectorAll('.custom-dot');\n      allDots.forEach((dot, idx) => {\n        dot.classList.toggle('active', idx === currentIndex);\n      });\n    });\n  });\n</script>"
              },
