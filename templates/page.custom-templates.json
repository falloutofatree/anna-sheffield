            "ai_gen_block_fae9c10_Cha8aD": {
              "type": "ai_gen_block_fae9c10",
              "settings": {
                "desktop_width_percent": 100,
                "border_radius": 0,
                "content_padding": 20,
                "content_text_color": "#000000",
                "dot_size": 10,
                "dot_active_color": "#000000",
                "dot_inactive_color": "#cccccc",
                "slide_1_enabled": true,
                "slide_1_image": "shopify://shop_images/Group_6_2x_2000x_2000x_6ae82114-5dba-48f2-8191-629b13750b4e.webp",
                "slide_1_aspect_ratio": "3/2",
                "slide_1_fit": "contain",
                "slide_1_content": "<p>DIAMOND MELÉE INITIATIVE<br/><br/>Our reclaimed diamond melée initiative weighs in at roughly 200 carats per year. Since the mining of one total carat of even these tiny diamonds requires the movement of approximately 250 tons of sediment, this project alone saves on the disturbance of over 400,000 tons of earth annually.</p>",
                "slide_2_enabled": true,
                "slide_2_image": "shopify://shop_images/Group_9_2x_2000x_2000x_b1bc648d-9740-40c7-a1ab-87c24ed185b7.webp",
                "slide_2_aspect_ratio": "3/2",
                "slide_2_fit": "contain",
                "slide_2_content": "<p>RECYCLED GOLD INITIATIVE<br/><br/>Additionally, our exclusive use of recycled gold—totaling around 6,220 grams each year—means we have not contributed to the movement of roughly 6,165 tons of sediment.</p>",
                "slide_3_enabled": false,
