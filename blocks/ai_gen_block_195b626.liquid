{% doc %}
  @prompt
    Create a 5 slides landscape image slider. Each slide has an image with fit and fill setting and bellow it is left aligned rich text editor. 
    
    Add a toggle to show and hide each slide.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-landscape-slider-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-landscape-slider-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-landscape-slider-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
  }

  .ai-landscape-slider-slide-{{ ai_gen_id }} {
    min-width: 100%;
    flex-shrink: 0;
  }

  .ai-landscape-slider-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    overflow: hidden;
    background-color: #f4f4f4;
    margin-bottom: 20px;
  }

  .ai-landscape-slider-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    {% if block.settings.image_fit == 'cover' %}
      object-fit: cover;
    {% else %}
      object-fit: contain;
    {% endif %}
  }

  .ai-landscape-slider-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-landscape-slider-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 300px;
  }

  .ai-landscape-slider-text-{{ ai_gen_id }} {
    text-align: left;
    color: {{ block.settings.text_color }};
    padding: 0 20px;
  }

  .ai-landscape-slider-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  .ai-landscape-slider-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-landscape-slider-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-landscape-slider-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-landscape-slider-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
  }

  .ai-landscape-slider-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-landscape-slider-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-landscape-slider-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-landscape-slider-text-{{ ai_gen_id }} {
      padding: 0 10px;
    }
  }
{% endstyle %}

<landscape-slider-{{ ai_gen_id }}
  class="ai-landscape-slider-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-landscape-slider-container-{{ ai_gen_id }}">
    <div class="ai-landscape-slider-track-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
          assign slide_image_key = 'slide_' | append: i | append: '_image'
          assign slide_text_key = 'slide_' | append: i | append: '_text'

          assign slide_enabled = block.settings[slide_enabled_key]
          assign slide_image = block.settings[slide_image_key]
          assign slide_text = block.settings[slide_text_key]
        %}

        {% if slide_enabled %}
          <div class="ai-landscape-slider-slide-{{ ai_gen_id }}" data-slide="{{ i }}">
            <div class="ai-landscape-slider-image-wrapper-{{ ai_gen_id }}">
              {% if slide_image %}
                <img
                  src="{{ slide_image | image_url: width: 2000 }}"
                  alt="{{ slide_image.alt | escape }}"
                  loading="lazy"
                  width="{{ slide_image.width }}"
                  height="{{ slide_image.height }}"
                >
              {% else %}
                <div class="ai-landscape-slider-image-placeholder-{{ ai_gen_id }}">
                  {{ 'hero-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if slide_text != blank %}
              <div class="ai-landscape-slider-text-{{ ai_gen_id }}">
                {{ slide_text }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="ai-landscape-slider-controls-{{ ai_gen_id }}">
    <button
      class="ai-landscape-slider-button-{{ ai_gen_id }} ai-landscape-slider-prev-{{ ai_gen_id }}"
      aria-label="Previous slide"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <div class="ai-landscape-slider-dots-{{ ai_gen_id }}"></div>

    <button
      class="ai-landscape-slider-button-{{ ai_gen_id }} ai-landscape-slider-next-{{ ai_gen_id }}"
      aria-label="Next slide"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</landscape-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class LandscapeSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-landscape-slider-track-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-landscape-slider-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-landscape-slider-next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-landscape-slider-dots-{{ ai_gen_id }}');

        this.slides = Array.from(this.querySelectorAll('.ai-landscape-slider-slide-{{ ai_gen_id }}'));
        
        if (this.slides.length === 0) return;

        this.createDots();
        this.setupEventListeners();
        this.updateSlider();
      }

      createDots() {
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-landscape-slider-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.previousSlide());
        this.nextButton.addEventListener('click', () => this.nextSlide());
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlider();
      }

      previousSlide() {
        if (this.currentSlide > 0) {
          this.currentSlide--;
          this.updateSlider();
        }
      }

      nextSlide() {
        if (this.currentSlide < this.slides.length - 1) {
          this.currentSlide++;
          this.updateSlider();
        }
      }

      updateSlider() {
        const offset = -this.currentSlide * 100;
        this.track.style.transform = `translateX(${offset}%)`;

        this.prevButton.disabled = this.currentSlide === 0;
        this.nextButton.disabled = this.currentSlide === this.slides.length - 1;

        const dots = this.dotsContainer.querySelectorAll('.ai-landscape-slider-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('landscape-slider-{{ ai_gen_id }}', LandscapeSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Landscape image slider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
