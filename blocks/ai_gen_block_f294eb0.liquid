{% doc %}
  @prompt
    Please build a completely custom Shopify section called cross-sell-carousel.liquid. I need the full code including the {% schema %}, Liquid markup, CSS <style>, and any necessary JavaScript. Please adhere strictly to the following technical requirements:
    
    1. Section Schema (Settings):
    
    Collection Picker: To select the source collection for the cross-sell products.
    
    Rich Text (Title): Customizable section title.
    
    Rich Text (Description): Customizable short description under the title.
    
    URL & Text (CTA): A customizable "Shop Now" button/link.
    
    Color Pickers: For the card background color and the section background color.
    
    2. Layout & Structure (Desktop & Mobile):
    
    The layout must be a horizontal scrolling track containing the product cards.
    
    Desktop: Each product card must be exactly 25vw (25% of the viewport width). This means 4 cards are fully visible at a time.
    
    Mobile: Make it responsive so each card is 50vw on mobile screens (2 cards visible) or 75vw on very small screens.
    
    Text Overlay: The section Title and Description must be position: absolute; and sit directly on top of the scrolling carousel. Center it horizontally and vertically over the section, or pin it to the top/left based on standard UI practices. Ensure it has a high z-index so it sits above the scrolling images.
    
    CTA Placement: The "Shop Now" button must be positioned at the very bottom of the section, below the scrolling track.
    
    3. Product Card Styling:
    
    Card Dimensions: The card itself must have a strict aspect-ratio: 2 / 3; (vertical).
    
    Card Background: Apply the background color from the schema.
    
    Borders: Each card must have a border-right: 1px solid #e5e5e5; (light grey) to separate them.
    
    Image Dimensions: Inside the 2:3 card, the actual product image must be aspect-ratio: 1 / 1;.
    
    Image Positioning: Use Flexbox or Grid on the card to center the 1:1 image perfectly in the middle of the 2:3 card. The image should use object-fit: contain; so it is not cropped.
    
    Content Restrictions: DO NOT output the product title, product price, or product description. The card must only contain the image.
    
    Link: Wrap the entire card in an <a> tag linking to product.url.
    
    4. Animation & Behavior:
    
    Continuous Auto-Scroll: Do not use standard scrollbars or snap-scrolling. Please build an infinite, continuous auto-scrolling marquee effect using CSS @keyframes (translating from 0 to -100%).
    
    To make the infinite scroll seamless, you will likely need to duplicate the for product in collection.products loop twice inside the scrolling track so it repeats smoothly without jumping.
    
    Pause the animation on hover (animation-play-state: paused;).
{% enddoc %}
{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cross-sell-carousel-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    background-color: {{ section.settings.section_background_color }};
    overflow: hidden;
    display: block;
  }

  .ai-cross-sell-carousel__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    text-align: center;
    max-width: 90%;
    pointer-events: none;
  }

  .ai-cross-sell-carousel__title-{{ ai_gen_id }} {
    color: {{ section.settings.text_color }};
    margin: 0 0 16px;
    font-size: 48px;
    line-height: 1.2;
  }

  .ai-cross-sell-carousel__description-{{ ai_gen_id }} {
    color: {{ section.settings.text_color }};
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
  }

  .ai-cross-sell-carousel__track-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .ai-cross-sell-carousel__track-{{ ai_gen_id }} {
    display: flex;
    width: fit-content;
    animation: ai-cross-sell-scroll-{{ ai_gen_id }} 40s linear infinite;
  }

  .ai-cross-sell-carousel__track-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  @keyframes ai-cross-sell-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-cross-sell-carousel__card-{{ ai_gen_id }} {
    width: 25vw;
    aspect-ratio: 2 / 3;
    background-color: {{ section.settings.card_background_color }};
    border-right: 1px solid #e5e5e5;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    position: relative;
  }

  .ai-cross-sell-carousel__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-cross-sell-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
  }

  .ai-cross-sell-carousel__cta-wrapper-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 40px 20px;
    background-color: {{ section.settings.section_background_color }};
  }

  .ai-cross-sell-carousel__cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 32px;
    background-color: #000000;
    color: #ffffff;
    text-decoration: none;
    border-radius: 0;
    font-size: 14px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
    pointer-events: auto;
  }

  .ai-cross-sell-carousel__cta-{{ ai_gen_id }}:hover {
    background-color: #333333;
  }

  @media screen and (max-width: 749px) {
    .ai-cross-sell-carousel__card-{{ ai_gen_id }} {
      width: 50vw;
    }

    .ai-cross-sell-carousel__title-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-cross-sell-carousel__description-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-cross-sell-carousel__card-{{ ai_gen_id }} {
      width: 75vw;
    }

    .ai-cross-sell-carousel__title-{{ ai_gen_id }} {
      font-size: 24px;
    }
  }
{% endstyle %}

<cross-sell-carousel-{{ ai_gen_id }} class="ai-cross-sell-carousel-{{ ai_gen_id }}">
  {% if section.settings.title != blank or section.settings.description != blank %}
    <div class="ai-cross-sell-carousel__overlay-{{ ai_gen_id }}">
      {% if section.settings.title != blank %}
        <div class="ai-cross-sell-carousel__title-{{ ai_gen_id }}">
          {{ section.settings.title }}
        </div>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="ai-cross-sell-carousel__description-{{ ai_gen_id }}">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-cross-sell-carousel__track-wrapper-{{ ai_gen_id }}">
    <div class="ai-cross-sell-carousel__track-{{ ai_gen_id }}">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products %}
          <a href="{{ product.url }}" class="ai-cross-sell-carousel__card-{{ ai_gen_id }}">
            <div class="ai-cross-sell-carousel__image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-cross-sell-carousel__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% endif %}
            </div>
          </a>
        {% endfor %}
        {% for product in section.settings.collection.products %}
          <a href="{{ product.url }}" class="ai-cross-sell-carousel__card-{{ ai_gen_id }}">
            <div class="ai-cross-sell-carousel__image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-cross-sell-carousel__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% endif %}
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  {% if section.settings.cta_text != blank and section.settings.cta_url != blank %}
    <div class="ai-cross-sell-carousel__cta-wrapper-{{ ai_gen_id }}">
      <a href="{{ section.settings.cta_url }}" class="ai-cross-sell-carousel__cta-{{ ai_gen_id }}">
        {{ section.settings.cta_text }}
      </a>
    </div>
  {% endif %}
</cross-sell-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CrossSellCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-cross-sell-carousel__track-{{ ai_gen_id }}');
        if (this.track) {
          this.adjustAnimationSpeed();
        }
      }

      adjustAnimationSpeed() {
        const trackWidth = this.track.scrollWidth / 2;
        const duration = trackWidth / 50;
        this.track.style.animationDuration = duration + 's';
      }
    }

    customElements.define('cross-sell-carousel-{{ ai_gen_id }}', CrossSellCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Cross-sell carousel",
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Text overlay"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Shop the collection</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover our curated selection of products</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Cross-sell carousel"
    }
  ]
}
{% endschema %}
