      "id": "nav_button_opacity",
      "label": "Button opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "color",
      "id": "nav_button_color",
      "label": "Button color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_button_hover_color",
      "label": "Button hover color",
      "default": "#000000"
    },
    {
      "type": "color",
