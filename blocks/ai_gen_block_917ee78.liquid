{% doc %}
  @prompt
    create a 5 slides landscape image slider
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-slider-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-image-slider-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-image-slider-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }

  .ai-image-slider-slide-{{ ai_gen_id }} {
    min-width: 100%;
    position: relative;
    aspect-ratio: {{ block.settings.aspect_ratio }};
  }

  .ai-image-slider-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-image-slider-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-slider-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-image-slider-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-slider-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_icon_color }};
    border: none;
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background-color 0.3s ease, opacity 0.3s ease;
    opacity: {{ block.settings.nav_button_opacity | divided_by: 100.0 }};
  }

  .ai-image-slider-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
    opacity: 1;
  }

  .ai-image-slider-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-image-slider-nav-prev-{{ ai_gen_id }} {
    left: {{ block.settings.nav_button_offset }}px;
  }

  .ai-image-slider-nav-next-{{ ai_gen_id }} {
    right: {{ block.settings.nav_button_offset }}px;
  }

  .ai-image-slider-nav-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.nav_button_size }}px * 0.5);
    height: calc({{ block.settings.nav_button_size }}px * 0.5);
  }

  .ai-image-slider-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 16px 0;
    position: absolute;
    bottom: {{ block.settings.dots_offset }}px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .ai-image-slider-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease;
    opacity: {{ block.settings.dot_opacity | divided_by: 100.0 }};
  }

  .ai-image-slider-dot-{{ ai_gen_id }}:hover {
    transform: scale(1.2);
    opacity: 1;
  }

  .ai-image-slider-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-image-slider-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-image-slider-nav-{{ ai_gen_id }} {
      width: calc({{ block.settings.nav_button_size }}px * 0.8);
      height: calc({{ block.settings.nav_button_size }}px * 0.8);
    }

    .ai-image-slider-nav-prev-{{ ai_gen_id }} {
      left: calc({{ block.settings.nav_button_offset }}px * 0.5);
    }

    .ai-image-slider-nav-next-{{ ai_gen_id }} {
      right: calc({{ block.settings.nav_button_offset }}px * 0.5);
    }
  }
{% endstyle %}

<image-slider-{{ ai_gen_id }} class="ai-image-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-slider-container-{{ ai_gen_id }}">
    <div class="ai-image-slider-track-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign image_key = 'slide_' | append: i | append: '_image'
          assign image = block.settings[image_key]
        %}
        <div class="ai-image-slider-slide-{{ ai_gen_id }}" data-slide="{{ i }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 2000 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          {% else %}
            <div class="ai-image-slider-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-image-slider-empty-state-{{ ai_gen_id }}">
                Add image for slide {{ i }}
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if block.settings.show_nav_buttons %}
      <button
        class="ai-image-slider-nav-{{ ai_gen_id }} ai-image-slider-nav-prev-{{ ai_gen_id }}"
        aria-label="Previous slide"
        data-direction="prev"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="ai-image-slider-nav-{{ ai_gen_id }} ai-image-slider-nav-next-{{ ai_gen_id }}"
        aria-label="Next slide"
        data-direction="next"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-image-slider-dots-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          <button
            class="ai-image-slider-dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
            aria-label="Go to slide {{ i }}"
            data-slide="{{ i }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</image-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 1;
        this.totalSlides = 5;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-image-slider-track-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-image-slider-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-image-slider-nav-next-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-image-slider-dot-{{ ai_gen_id }}');

        this.setupEventListeners();
        this.updateSlider();

        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.goToPrevSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.goToNextSlide());
        }

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideNumber = parseInt(e.target.dataset.slide);
            this.goToSlide(slideNumber);
          });
        });

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          {% if block.settings.autoplay %}
            this.startAutoplay();
          {% endif %}
        });
      }

      goToSlide(slideNumber) {
        this.currentSlide = slideNumber;
        this.updateSlider();
      }

      goToPrevSlide() {
        if (this.currentSlide > 1) {
          this.currentSlide--;
        } else if ({{ block.settings.loop }}) {
          this.currentSlide = this.totalSlides;
        }
        this.updateSlider();
      }

      goToNextSlide() {
        if (this.currentSlide < this.totalSlides) {
          this.currentSlide++;
        } else if ({{ block.settings.loop }}) {
          this.currentSlide = 1;
        }
        this.updateSlider();
      }

      updateSlider() {
        const offset = -(this.currentSlide - 1) * 100;
        this.track.style.transform = `translateX(${offset}%)`;

        this.dots.forEach((dot, index) => {
          if (index + 1 === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        if (this.prevButton) {
          this.prevButton.disabled = !{{ block.settings.loop }} && this.currentSlide === 1;
        }

        if (this.nextButton) {
          this.nextButton.disabled = !{{ block.settings.loop }} && this.currentSlide === this.totalSlides;
        }
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.goToNextSlide();
        }, {{ block.settings.autoplay_speed }} * 1000);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('image-slider-{{ ai_gen_id }}', ImageSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Image slider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Slides"
    },
    {
      "type": "image_picker",
      "id": "slide_1_image",
      "label": "Slide 1 image"
    },
    {
      "type": "image_picker",
      "id": "slide_2_image",
      "label": "Slide 2 image"
    },
    {
      "type": "image_picker",
      "id": "slide_3_image",
      "label": "Slide 3 image"
    },
    {
      "type": "image_picker",
      "id": "slide_4_image",
      "label": "Slide 4 image"
    },
    {
      "type": "image_picker",
      "id": "slide_5_image",
      "label": "Slide 5 image"
    },
    {
