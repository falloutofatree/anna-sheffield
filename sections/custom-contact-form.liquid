<div class="custom-contact-section" id="contact-section-{{ section.id }}">
  <div class="custom-contact-layout">
    
    <div class="custom-form-col">
      <h2 class="custom-contact-title">{{ section.settings.heading }}</h2>
      
      {% comment %} 
        Gorgias natively reads standard Shopify contact forms. 
        The 'contact[tags]' field helps automatically tag tickets in Gorgias.
      {% endcomment %}
      {% form 'contact', id: 'CustomContactForm' %}
        <input type="hidden" name="contact[tags]" value="Contact Form Section">
        
        {% if form.posted_successfully? %}
          <p class="custom-success-msg">Thanks for reaching out! We will get back to you shortly.</p>
        {% endif %}

        {{ form.errors | default_errors }}

        <div class="custom-input-group">
          <select id="ContactSubject" name="contact[Subject]" class="custom-contact-input" required>
            <option value="" disabled selected>Select a Subject*</option>
            <option value="Custom">CUSTOM</option>
            <option value="Nesting & Staking Bands">NESTING & STACKING BANDS</option>
            <option value="Order Status">ORDER STATUS</option>
            <option value="Financing">FINANCING</option>
            <option value="Pop Ups & Trunks Shows">POP UPS & TRUNKS SHOWS</option>
            <option value="Press">PRESS</option>
            <option value="Repairs">REPAIRS</option>
            <option value="Returns">RETURNS</option>
            <option value="Other">OTHER</option>
          </select>
        </div>

        <div class="custom-input-group">
          <input type="text" id="ContactName" name="contact[name]" placeholder="Name*" required class="custom-contact-input">
        </div>
        
        <div class="custom-input-group">
          <input type="email" id="ContactEmail" name="contact[email]" placeholder="Email*" required class="custom-contact-input" autocorrect="off" autocapitalize="off">
        </div>

        <div class="custom-input-group">
          <input type="tel" id="ContactPhone" name="contact[phone]" placeholder="Phone (Optional)" class="custom-contact-input" pattern="[0-9\-]*">
        </div>
        
        <div class="custom-input-group">
          <textarea id="ContactMessage" name="contact[body]" rows="4" placeholder="Leave us a message*" required class="custom-contact-input"></textarea>
        </div>
        
        <button type="submit" class="custom-contact-submit">SUBMIT</button>
      {% endform %}
    </div>

    <div class="custom-image-col">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1500 | image_tag: class: 'custom-contact-image', loading: 'lazy', alt: section.settings.heading }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'custom-contact-image placeholder-svg' }}
      {% endif %}
    </div>

  </div>
</div>

<style>
  /* Section Wrapper */
  #contact-section-{{ section.id }} {
    width: 100%;
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* 2-Column Flex Layout */
  #contact-section-{{ section.id }} .custom-contact-layout {
    display: flex;
    flex-direction: row;
    background: #fff;
    /* Optional: Adds a subtle border so it doesn't float endlessly on white pages */
    border: 1px solid rgba(0,0,0,0.08); 
    overflow: hidden;
  }

  /* Left Column: Form Settings */
  #contact-section-{{ section.id }} .custom-form-col {
    flex: 1;
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  #contact-section-{{ section.id }} .custom-contact-title {
    font-family: inherit;
    margin-top: 0;
    margin-bottom: 25px;
    font-size: 24px;
    letter-spacing: 0.5px;
  }

  #contact-section-{{ section.id }} .custom-success-msg {
    color: #2e7d32;
    font-size: 14px;
    margin-bottom: 15px;
  }

  /* Right Column: Image Settings */
  #contact-section-{{ section.id }} .custom-image-col {
    flex: 1;
    background: #f4f4f4;
    display: flex;
    min-height: 400px;
  }
  
  #contact-section-{{ section.id }} .custom-contact-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #contact-section-{{ section.id }} .placeholder-svg {
    width: 100%;
    height: 100%;
    fill: #ccc;
  }

  /* Input Fields */
  #contact-section-{{ section.id }} .custom-input-group { 
    margin-bottom: 15px; 
  }
  
  #contact-section-{{ section.id }} .custom-contact-input {
    width: 100%;
    padding: 14px;
    border: 1px solid #ddd;
    font-family: inherit;
    font-size: 14px;
    box-sizing: border-box;
    background-color: #fff;
    color: #000;
  }
  
  #contact-section-{{ section.id }} .custom-contact-input:focus { 
    outline: none; 
    border-color: #000; 
  }
  
  #contact-section-{{ section.id }} select.custom-contact-input {
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 1em;
  }

  /* Submit Button */
  #contact-section-{{ section.id }} .custom-contact-submit {
    width: 100%; 
    background: #000; 
    color: #fff;
    padding: 16px; 
    border: none; 
    cursor: pointer;
    font-family: inherit; 
    font-size: 13px;
    letter-spacing: 1px; 
    margin-top: 10px; 
    transition: background 0.2s ease;
  }
  
  #contact-section-{{ section.id }} .custom-contact-submit:hover { 
    background: #333; 
  }

  /* Form Errors */
  #contact-section-{{ section.id }} .errors {
    color: #d80000;
    margin-bottom: 15px;
    font-size: 14px;
  }

  /* MOBILE RESPONSIVENESS */
  @media screen and (max-width: 768px) {
    #contact-section-{{ section.id }} {
      padding: 0;
      margin: 0;
      border: none;
    }
    
    #contact-section-{{ section.id }} .custom-contact-layout {
      flex-direction: column-reverse; /* Puts image on top on mobile */
      border: none;
    }
    
    #contact-section-{{ section.id }} .custom-image-col {
      height: 300px;
      min-height: auto;
      flex: none;
    }
    
    #contact-section-{{ section.id }} .custom-form-col {
      padding: 40px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Contact Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image",
      "info": "Upload the image displayed next to the contact form."
    }
  ],
  "presets": [
    {
      "name": "Contact Section",
      "category": "Forms"
    }
  ]
}
{% endschema %}
